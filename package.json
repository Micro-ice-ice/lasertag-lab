{
  "name": "lasertag-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "imports": { "#lib/*": "./src/lib/*" },
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "vite dev --host 127.0.0.1",
    "build": "vite build",
    "start": "vite preview --host 127.0.0.1 --port 3000",
    "preview": "vite preview --host 127.0.0.1",
    "check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
    "test": "node --test",
    "import:game": "node scripts/import-game.mjs",
    "sync:games": "node scripts/sync-games.mjs"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "4.0.0",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@opentelemetry/api": "^1.9.0",
    "svelte": "5.57.2",
    "svelte-check": "^4.0.0",
    "typescript": "^6.0.0",
    "vite": "8.3.5"
  }
}
